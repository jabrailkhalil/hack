FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 MPLCONFIGDIR=/tmp/matplotlib \
    TRAM_DATASET=/dataset TRAM_CACHE=/cache TRAM_RUNS=/runs \
    TRAM_MODELS=/models TRAM_STATE=/state TRAM_FRONTEND=/opt/frontend \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /opt/lab
COPY requirements.txt requirements-web.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-web.txt
COPY src/ ./src/
RUN pip install --no-build-isolation --no-deps .
COPY tests/ ./tests/
COPY --from=frontend /build/dist /opt/frontend
EXPOSE 8080
CMD ["uvicorn", "tram_lab.web.app:app", "--host", "0.0.0.0", "--port", "8080"]
