+    def _reliability(self, t, raw, statuses, accepted):
+        """Attribute only identifiable anomalies; retain at most four per wheel.
+
+        A held sample is not new evidence. Missing data and common model drift
+        are not channel-specific faults. Finite expiry prevents a permanent
+        blacklist, while one accepted sample cannot erase a recent anomaly.
+        """
+        window = self.c.h05_history_s
+        if window == 0.0:
+            return [1.0, 1.0]
+        result = []
+        for i, sample in enumerate(raw):
+            events = self.h05_events[i]
+            seen = self.h05_seen[i]
+            if (self._valid(sample, t, self.c.max_age_s) and sample.t <= t and
+                    (seen is None or sample.t > seen) and
+                    statuses[i] != 'DUPLICATE_OR_OLD'):
+                self.h05_seen[i] = sample.t
+                local_failure = statuses[i] in ('RANGE', 'RATE_ANOMALY')
+                attributed = (1 - i in accepted and i not in accepted and
+                              statuses[i] in ('MODEL_DISAGREEMENT', 'AMBIGUOUS_PAIR'))
+                if local_failure or attributed:
+                    events.append(sample.t)
+            while events and t - events[0] >= window:
+                events.popleft()
+            debt = sum(max(0.0, 1.0 - (t - stamp) / window) for stamp in events)
+            result.append(max(self.c.h05_min_reliability, 1.0 / (1.0 + debt)))
+        return result
 
