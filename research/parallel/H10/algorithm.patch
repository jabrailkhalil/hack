+    def _joint_bound_covariance(self):
+        """PSD-preserving diagonal rescaling, then roundoff-only correlation clamp.
+
+        A bounded variable cannot have variance above its squared half-range.
+        This is a numerical envelope, not a calibrated confidence interval.
+        """
+        vv, dd = max(1e-8, self.pv), max(0.0, self.pd)
+        bv = min(vv, max(1e-8, self.c.max_speed_mps ** 2))
+        bd = min(dd, self.c.disturbance_limit_mps2 ** 2)
+        scale = math.sqrt(bv / vv) * (math.sqrt(bd / dd) if dd else 0.0)
+        self.pv, self.pd = bv, bd
+        bound = math.sqrt(bv) * math.sqrt(bd)
+        self.pvd = clip(self.pvd * scale, -bound, bound)
+
+    def _joint_predict(self, dt, command_stale, u, alpha, a_model, predicted):
+        """First-order conditional motion Jacobian and integrated random-walk Q.
+
+        The actuator mean is unchanged. Its uncertainty/history is not a third
+        Kalman state, so this covariance is explicitly an approximation.
+        """
+        c, v = self.c, self.v
+        q = min(1.0, max(0.0, (abs(u) - c.command_deadband) /
+                            (1.0 - c.command_deadband))) ** c.command_exponent
+        tanh_v = math.tanh(v / .20)
+        resistance_slope = (c.rolling_force_n * (1.0 - tanh_v * tanh_v) / .20 +
+                            2.0 * c.quadratic_drag_n_s2_m2 * abs(v)) / c.mass_kg
+        if u < 0:
+            target_slope = -q * c.max_brake_force_n * (1.0 - tanh_v * tanh_v) / (.20 * c.mass_kg)
+        else:
+            torque_force = c.efficiency * c.gear_ratio * c.total_motor_torque_nm / c.wheel_radius_m
+            power_limited = abs(v) > 1.0 and c.max_power_w / abs(v) < torque_force
+            target_slope = (-c.travel_direction * q * c.max_power_w * math.copysign(1.0, v) /
+                            (c.mass_kg * v * v)) if power_limited else 0.0
+        f, g = 1.0, 0.0
+        if abs(a_model) < c.max_accel_mps2:
+            f += dt * (alpha * target_slope - resistance_slope)
+            g = dt
+        if predicted != v + dt * a_model:  # speed or no-sign-reversal projection
+            f, g = 0.0, 0.0
+        qd = c.joint_disturbance_process_noise if c.disturbance_limit_mps2 else 0.0
+        vv, vd, dd = self.pv, self.pvd, self.pd
+        self.pv = (f * f * vv + 2.0 * f * g * vd + g * g * dd +
+                   c.process_noise_v * dt * (4.0 if command_stale else 1.0) + qd * dt ** 3 / 3.0)
+        self.pvd = f * vd + g * dd + qd * dt * dt / 2.0
+        self.pd = dd + qd * dt
+        self._joint_bound_covariance()
+        return self.pv
+
+    def _joint_can_learn(self, samples, fused, command_stale):
+        # Exactly the baseline adaptation eligibility, not a new fault detector.
+        if not fused or command_stale or self.adapt_previous is None:
+            return False
+        z = (samples[0].value + samples[1].value) * .5
