+                                self.c.disturbance_limit_mps2)
+        self.pv = (1.0 - kv) ** 2 * vv + kv * kv * r
+        self.pvd = (1.0 - kv) * (vd - kd * vv) + kv * kd * r
+        self.pd = dd - 2.0 * kd * vd + kd * kd * innovation_variance
+        if self.disturbance != unbounded_d:
+            self.pvd = 0.0  # do not carry an unconstrained cross term through projection
+        self._joint_bound_covariance()
 
