ClearAll[t,h,delta,g0,j,d,s,tau,ep,sig,rho,em,c]; ass=Element[{t,h,delta,g0,j,d,tau,sig,rho,em},Reals]&&h>=0&&delta>0&&tau>0;
gm=FullSimplify[Integrate[g0+j*s,{s,t-h-delta,t-h}]/delta,ass]; ma=gm+d; endpoint=FullSimplify[ma-g0-j*t,ass]; interval=FullSimplify[ma-gm,ass];
<|"mean_g"->gm,"endpoint_bias"->FullSimplify[endpoint-d,ass],"interval_target"->interval,"constant_g_agrees"->FullSimplify[(endpoint/.j->0)==interval,ass],"contraction_error"->FullSimplify[ep+(1-Exp[-delta/tau])*(-ep),ass],"contraction_valid"->FullSimplify[0<Exp[-delta/tau]<1,ass],"speed_difference_noise_variance"->2*(1-rho)*sig^2/delta^2,"model_g_plus_em_target"->FullSimplify[ma-gm-em,ass],"clipping_counterexample_true_d2"->Clip[2+2,{-3,3}]-2,"g_d_shift_unidentifiable"->FullSimplify[(g0-c+j*s)+(d+c)==g0+j*s+d],"units"->UnitSimplify[Quantity[1,"Meters"/"Seconds"]/Quantity[1,"Seconds"]]|>
