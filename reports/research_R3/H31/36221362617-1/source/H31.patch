+    o.command_epoch=(0,0.)
+    o.base.drive_a=.2
+    for k in (2,4,6):
+        o.scores.append(CompletedScore(k,k+1,k+1.1,(2.,0.,1.)))
+    # Most recent record age<4s at 10.05.
+    return o
