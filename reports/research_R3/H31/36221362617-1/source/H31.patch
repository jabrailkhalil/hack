+                        ev.Observer=(lambda cc:GuardedReadoutObserver(cc,readout=r)) if name=='v8' else (lambda cc:PrequentialOutageObserver(cc,readout=r))
+                        ts=time.perf_counter_ns();cs=time.process_time_ns()
